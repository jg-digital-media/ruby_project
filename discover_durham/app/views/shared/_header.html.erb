    <header>

        <aside class="website---heading">

            <div class = "discover---durham--container">            

                <h1>Discover Durham <p>(A Ruby Rails Project)</span></p></h1>

                <%= image_tag "doorknock-1.png",
                    loading: "lazy",
                    id: "discover---durham--logo",
                    class: "image_gallery_item_homepage",
                    alt: "doorknocker image from durham cathedral version 1",
                    title: "doorknocker image from durham cathedral version 1" 
                %>
               
            </div>

            <div class="hamburger---menu--container" id="js---ham_icon" role="button" aria-label="Toggle navigation menu" aria-expanded="false" tabindex="0">
                <span class="hamburger---icon" aria-hidden="true">
                    <span class="hamburger---icon--line"></span>
                    <span class="hamburger---icon--line"></span>
                    <span class="hamburger---icon--line"></span>
                </span>
            </div>

        </aside>

    </header>

    <nav class="main---navigation--container" id="siteNav">

        <ul>
        
            <li><a href="#" id="close-menu-btn">(&uparrow;)</a></li> 

            <li>
                <%= link_to root_path, class: ("active" if current_page?(root_path)) do %>
                    <span class="nav---icon " aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M12 3.2 4 10v10h6v-6h4v6h6V10L12 3.2z" /></svg>
                    </span>

                    <span class="nav---label">Home</span>
                <% end %>
            </li>
            <li>
                <%= link_to about_path, class: ("active" if current_page?(about_path)) do %>
                    <span class="nav---icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4zm0 2c-4.4 0-8 2.2-8 5v1h16v-1c0-2.8-3.6-5-8-5z"/></svg>
                    </span>

                    <span class="nav---label">About</span>
                <% end %>
            </li>
            <li>
                <%= link_to history_path, class: ("active" if current_page?(history_path)) do %>
                    <span class="nav---icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M6 2h12a2 2 0 0 1 2 2v16l-4-2-4 2-4-2-4 2V4a2 2 0 0 1 2-2zm1 6h10v2H7V8zm0 4h10v2H7v-2z"/>
                    </svg>
                    </span>

                    <span class="nav---label">History</span>
                <% end %>
            </li>
            <li>
                <%= link_to attractions_path, class: ("active" if current_page?(attractions_path)) do %>
                    <span class="nav---icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M12 2 3 9h2v11h14V9h2L12 2zm0 3.8 5 4.5V18H7v-7.7l5-4.5z"/>
                    </svg>
                    </span>

                    <span class="nav---label">Attractions</span>
                <% end %>
            </li>
            <li>
                <%= link_to events_path, class: ("active" if current_page?(events_path)) do %>
                    <span class="nav---icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M7 2v2H5a2 2 0 0 0-2 2v2h18V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2H7zm14 8H3v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V10zM7 13h2v2H7v-2z"/>
                    </svg>
                    </span>

                    <span class="nav---label">Events</span>
                <% end %>
            </li>
            <li>
                <%= link_to coffee_path, class: ("active" if current_page?(coffee_path)) do %>
                    <span class="nav---icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M6 4h12v2h1a3 3 0 0 1 0 6h-1v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4zm2 2v12h8V6H8zm10 0h1a1 1 0 0 1 0 2h-1V6z"/>
                    </svg>
                    </span>

                    <span class="nav---label">Coffee</span>
                <% end %>
            </li>
            <li>
                <%= link_to links_path, class: ("active" if current_page?(links_path)) do %>
                    <span class="nav---icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M10.6 14.4a3 3 0 0 1 0-4.2l1.8-1.8a3 3 0 0 1 4.2 4.2l-.9.9h-2.3l1.1-1.1a1 1 0 1 0-1.4-1.4l-1.8 1.8a1 1 0 0 0 0 1.4 1 1 0 0 1 0 1.4zm2.8-4.8a3 3 0 0 1 0 4.2l-1.8 1.8a3 3 0 0 1-4.2-4.2l.9-.9h2.3l-1.1 1.1a1 1 0 1 0 1.4 1.4l1.8-1.8a1 1 0 0 0 0-1.4 1 1 0 0 1 0-1.4"/>
                    </svg>
                    </span>

                    <span class="nav---label">Links</span>
                <% end %>
            </li>             
           
        </ul>
        
    </nav>

    <script>

        (function () {
            var cookiePrefix = "discover_durham_menu_active=";
            var cookies = document.cookie.split(";");
            var menuHidden = false;

            for (var i = 0; i < cookies.length; i++) {
                if (cookies[i].trim().indexOf(cookiePrefix) === 0) {
                    menuHidden = cookies[i].trim().substring(cookiePrefix.length) === "1";
                    break;
                }
            }

            if (menuHidden) {
                var hamIcon = document.getElementById("js---ham_icon");
                var siteNav = document.getElementById("siteNav");

                if (hamIcon) {
                    hamIcon.classList.add("active");
                    hamIcon.setAttribute("aria-expanded", "true");
                }

                if (siteNav) {
                    siteNav.classList.add("active");
                }
            }
        }());
    </script>

    